<?xml version="1.0" encoding="utf-8"?>
<!--
  [구글플레이 자동화 도전 · 2026-08-28 대표 결정] play flavor 접근성 선언.

  ★ 이 파일이 들어간 play 빌드는 **프로덕션에 올리지 않는다. 비공개 테스트 트랙 전용.**
    승인 확인 후에만 프로덕션으로 승격한다. 거부돼도 현재 유저는 영향 없다.

  구글 정책 근거 (support.google.com/googleplay/android-developer/answer/10964491):
   · 접근성 API 의 비접근성 용도를 **허용**한다 — 금지가 아니라 '선언 + 앱내 명시적 고지·동의' 조건부.
   · 2026년 신설 조항이 막는 건 "앱이 자율적으로 판단해 행동을 개시·계획·실행하는 것".
     콜레이더는 **읽기만** 하고 버튼을 누르지 않는다 → 명시적 허용 범위.
   · isAccessibilityTool 은 **절대 켜지 않는다.** 구글이 automation tool 을 접근성 도구에서
     명시 제외했고, 허위 선언은 개발자 계정 해지 사유다.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".NaviIntentReceiver"
            android:exported="false"
            android:label="콜레이더 자동기록"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 자동기록의 GPS 좌표 소스. 이게 없으면 좌표=0 이라 트립이 안 만들어진다. -->
        <service
            android:name=".LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
