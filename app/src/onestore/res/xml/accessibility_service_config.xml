<?xml version="1.0" encoding="utf-8"?>
<!--
  [원스토어 전용] v9 접근성 설정. 택시 기사앱 4종만 대상.
  실제 이벤트/플래그는 NaviIntentReceiver.onServiceConnected()에서 프로그래밍적으로도 설정됨.
