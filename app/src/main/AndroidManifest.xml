<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 인터넷 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 포그라운드 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- [v18] 화면 스샷 공유(MediaProjection) — 유저 개시 캡처→워터마크→공유. 선언+시연영상과 함께 심사. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- GPS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- [스토어버전] 접근성 권한 제거 -->

    <!-- 카메라 (영수증 OCR) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- [v13] 플로팅 오버레이 버튼 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 배터리 최적화 예외 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 부팅 시 자동 시작 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="콜레이더"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallRadar"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- ML Kit OCR 모델 자동 다운로드 (Play Services 방식) -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <!-- 메인 화면 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="콜레이더"
            android:theme="@style/Theme.CallRadar"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- [v12] 카카오 로그인 딥링크: 브라우저에서 callradar://auth 로 앱 복귀 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="callradar" android:host="auth" />
            </intent-filter>
        </activity>

        <!-- 영수증 스캔 -->
        <activity
            android:name=".ReceiptScanActivity"
            android:exported="false"
            android:label="영수증 스캔" />

        <!-- [v18] 과거기록 이미지 가져오기 -->
        <activity
            android:name=".ImageImportActivity"
            android:exported="false"
            android:label="과거기록 가져오기" />

        <!-- [v19] 기사 디지털 명함 -->
        <activity
            android:name=".NameCardActivity"
            android:exported="false"
            android:label="기사 명함" />

        <!-- [v19] 요금 미터기(추정) -->
        <activity
            android:name=".MeterActivity"
            android:exported="false"
            android:label="요금 미터기" />

        <!-- [v18] 운행완료 후 금액 팝업 -->
        <activity
            android:name=".QuickEntryActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />

        <!-- [스토어버전] 접근성 자동기록 제거 (NaviIntentReceiver) -->

        <!-- [v13] 플로팅 운행 버튼 (오버레이) -->
        <service
            android:name=".FloatingTripService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- [v18] 근무 세션 거리 미터 (근무 중에만 위치 누적) -->
        <service
            android:name=".WorkSessionService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- [v19] 요금 미터기 플로팅 백그라운드 -->
        <service
            android:name=".MeterFloatingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- [v18] 화면 스샷 공유(MediaProjection) — 유저 개시 캡처→워터마크→공유 -->
        <!-- 공유 이미지 전달용 FileProvider (캐시 shares/ 폴더만 노출) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 화면캡처 동의(시스템 캡처 인텐트) 액티비티 (투명, 유저 탭으로만 실행) -->
        <activity
            android:name=".ScreenCapturePermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />

        <!-- 화면캡처 포그라운드 서비스 (1프레임 캡처→워터마크→공유 즉시 종료) -->
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- [v23][스토어버전 제외] 알림 자동캡처(CallCaptureService) — 자동화 차수(phase-2)에서만 등록.
             다른 앱 알림 읽기라 첫 심사엔 넣지 않음. phase-2 때 아래 주석 해제 + Config.NOTIF_CAPTURE_ENABLED=true.
        <service
            android:name=".CallCaptureService"
            android:exported="false"
            android:label="운행 금액 자동캡처"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        -->
    </application>

</manifest>
