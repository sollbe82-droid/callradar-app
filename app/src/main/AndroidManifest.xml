<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 인터넷 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 포그라운드 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- GPS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- [스토어버전] 접근성 권한 제거 -->

    <!-- 카메라 (영수증 OCR) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- [v13] 플로팅 오버레이 버튼 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 배터리 최적화 예외 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 부팅 시 자동 시작 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="콜레이더"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallRadar"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <!-- ML Kit OCR 모델 자동 다운로드 (Play Services 방식) -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <!-- 메인 화면 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="콜레이더"
            android:theme="@style/Theme.CallRadar"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- [v12] 카카오 로그인 딥링크: 브라우저에서 callradar://auth 로 앱 복귀 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="callradar" android:host="auth" />
            </intent-filter>
        </activity>

        <!-- [v43] 카카오 네이티브 로그인 리다이렉트 처리(kakao{네이티브키}://oauth) -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kakao${KAKAO_NATIVE_KEY}" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- 영수증 스캔 -->
        <activity
            android:name=".ReceiptScanActivity"
            android:exported="false"
            android:label="영수증 스캔" />

        <!-- [위치정보법 동의] 위치 수집 전 필수 동의 게이트 -->
        <activity
            android:name=".ConsentActivity"
            android:exported="false"
            android:label="이용 동의" />

        <!-- 매출 영수증 자동정산 (당일상세거래내역) -->
        <activity
            android:name=".ReceiptReconcileActivity"
            android:exported="false"
            android:label="매출 영수증 정산" />

        <!-- [명세서] 급여명세서 전항목 스캔 + 역산 -->
        <activity
            android:name=".PayslipScanActivity"
            android:exported="false"
            android:label="급여명세서 스캔" />

        <!-- [명세서] 회사 프로필 + 실시간 예상 기사몫 -->
        <activity
            android:name=".CompanyProfileActivity"
            android:exported="false"
            android:label="회사 프로필" />

        <!-- [세무] 개인택시 연간 세무 리포트(추정) -->
        <activity
            android:name=".TaxReportActivity"
            android:exported="false"
            android:label="세무 리포트" />

        <!-- [궤적] 오늘 운행 궤적(실차/공차) + PNG 공유 -->
        <activity
            android:name=".TrackActivity"
            android:exported="false"
            android:label="운행 궤적" />

        <!-- [v18] 과거기록 이미지 가져오기 -->
        <activity
            android:name=".ImageImportActivity"
            android:exported="false"
            android:label="과거기록 가져오기" />

        <!-- [v19] 기사 디지털 명함 -->
        <activity
            android:name=".NameCardActivity"
            android:exported="false"
            android:label="기사 명함" />

        <!-- [v83] 내 노하우 — 비공개=로컬 온리 노트 (서버 미전송) -->
        <activity
            android:name=".EventsActivity"
            android:exported="false"
            android:label="행사 수요 예보" />
        <activity
            android:name=".KnowhowActivity"
            android:exported="false"
            android:label="내 노하우" />

        <!-- [v19] 요금 미터기(추정) -->
        <activity
            android:name=".MeterActivity"
            android:exported="false"
            android:label="요금 미터기" />

        <!-- [v18] 운행완료 후 금액 팝업 -->
        <activity
            android:name=".QuickEntryActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />

        <!-- [스토어버전] 접근성 자동기록 제거 (NaviIntentReceiver) -->

        <!-- [v13] 플로팅 운행 버튼 (오버레이) -->
        <service
            android:name=".FloatingTripService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- [v18] 근무 세션 거리 미터 (근무 중에만 위치 누적) -->
        <service
            android:name=".WorkSessionService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- [v23] 근무 최대시간 초과 자동 마감 (부정확 알람 → 특수권한 불필요, 심사 영향 없음) -->
        <receiver
            android:name=".WorkAutoEndReceiver"
            android:exported="false" />

        <!-- [v19] 요금 미터기 플로팅 백그라운드 -->
        <service
            android:name=".MeterFloatingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- [v18] 화면 스샷 공유(MediaProjection) — 유저 개시 캡처→워터마크→공유 -->
        <!-- 공유 이미지 전달용 FileProvider (캐시 shares/ 폴더만 노출) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 화면캡처 동의(시스템 캡처 인텐트) 액티비티 (투명, 유저 탭으로만 실행) -->
        <activity
            android:name=".ScreenCapturePermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />

        <!-- [Play정책] MediaProjection FGS는 현재 미사용(v30에서 화면캡처 제거) → 선언 제거. 필요 시 시연영상과 함께 재선언. -->


        <!-- [v43] 알림 자동캡처(CallCaptureService) 등록 — 카드결제 승인 알림 금액 자동입력. Config.NOTIF_CAPTURE_ENABLED=true 병행. -->
        <service
            android:name=".CallCaptureService"
            android:exported="false"
            android:label="운행 금액 자동캡처"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
